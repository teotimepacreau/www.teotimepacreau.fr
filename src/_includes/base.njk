<!doctype html>
<html lang="fr-FR">
    <head>
        {% include "head.njk"%}
        <script defer fetchpriority="high" src="/scripts/colorTheme.js"></script>
        <script defer src="/scripts/aria-current.js"></script>
    </head>
    <body>
        {% include "color-picker.html"%}
        <div {% if pageId == "Homepage" %} id="homepage-container" {% else %} id="normal-page-container" {% endif %}
    
        {% if pageId == "Projets_list" or pageId == "Projet" %} class="projets-container" {% endif %}
        >
            <header {% if pageId == "Homepage" %} id="homepage-menu" {% endif %}>
            {% include "mobilenav.html"%}
            {% include "navigation.njk"%}
            </header>
            <main {% if pageId == "Tags" %}id="tags-page"{% elseif pageId == "Homepage" %}id="homepage-hero"{% elseif pageId == "CV" %}id="container-cv"{% elseif pageId == "Colophon" %}id="colophon"{% elseif pageId == "Projets_list" %}id="projets"{% elseif pageId == "Blog" %}id="blog"{% elseif pageId == "Projet" %}id="projet-layout"{% endif %}>
                {{ content | safe }}
            </main>
            <footer {% if pageId == "Homepage" %} class="homepage-footer menu-anim"{% endif %} id="footer">
                {% include "footer.html"%}
            </footer>
        </div>
                {% if pageId == "Homepage" %}
            <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
            <script>
            // Grab the prefers reduced motion preference of the user.
            let prefersReducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches;

            // SI L'UTILISATEUR N'A PAS ACTIVE prefers-reduced-motion alors on déroule l'animation
            if (!prefersReducedMotion) {
                gsap.fromTo(
                ".intersect",
                {
                    y: "-20dvh",
                    opacity: 0,
                    duration: 0.5,
                    ease: "power2.out",
                },
                {
                    y: "0dvh",
                    opacity: 1,
                    stagger: 0.3,
                }
                );
                gsap.fromTo(
                ".menu-anim",
                {
                    opacity: 0,
                    duration: 0.2,
                    ease: "power4.out",
                },
                {
                    opacity: 1,
                    delay: 1.2,
                }
                );


            }
            </script>
        {% endif %}
    </body>
</html>